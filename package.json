{
  "name": "sniff-n-frolic-pos",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "concurrently \"npm run dev:app\" \"npm run dev:services\"",
    "dev:app": "npm --prefix app run dev",
    "dev:services": "npm --prefix services run start:dev",
    "dev:all": "npm run db:up && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}